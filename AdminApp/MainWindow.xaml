<Window x:Class="AdminApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Admin Panel" Height="450" Width="600">

    <Grid Margin="10">

        <StackPanel>

            <TextBlock Text="Zaloguj jako admin" FontSize="16"/>

            <PasswordBox x:Name="PasswordBox" Width="200"/>

            <Button Content="Zaloguj"
                    Click="Login_Click"
                    Width="100"/>

            <Separator Margin="10"/>

            <TextBlock Text="Komputery:" FontSize="16"/>

            <ListBox x:Name="ClientsList" Height="150"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Zablokuj" Click="Block_Click"/>
                <Button Content="Odblokuj" Click="Unblock_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>

