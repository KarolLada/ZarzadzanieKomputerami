<Window x:Class="AdminApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel" Height="450" Width="600">

    <Grid Margin="10">


        <StackPanel x:Name="LoginPanel">

            <TextBlock Text="Zaloguj jako admin" FontSize="16" Margin="0,0,0,10"/>

            <PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,0,10"/>

            <Button Content="Zaloguj"
                    Click="Login_Click"
                    Width="100"/>

        </StackPanel>





        <StackPanel x:Name="AdminPanel" Visibility="Collapsed">

            <Button Content="Wyloguj"
                    Click="Logout_Click"
                    Width="100"
                    HorizontalAlignment="Right"/>

            <Separator Margin="10"/>

            <TextBlock Text="Timer (sekundy):"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <TextBox x:Name="TimerBox" Width="80" Margin="0,0,10,0"/>
                <Button Content="Start timer" Click="StartTimer_Click"/>
            </StackPanel>

            <Separator Margin="10"/>

            <TextBlock Text="Komputery:" FontSize="16"/>

            <ListBox x:Name="ClientsList" Height="150" Margin="0,5,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Zablokuj" Click="Block_Click" Margin="0,0,10,0"/>
                <Button Content="Odblokuj" Click="Unblock_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
