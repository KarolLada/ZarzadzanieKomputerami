<Window x:Class="ClientApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Panel"
        Height="500"
        Width="750"
        Background="#1e1e1e"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Kolory (TE SAME co admin) -->
        <SolidColorBrush x:Key="Primary" Color="#4CAF50"/>
        <SolidColorBrush x:Key="Danger" Color="#F44336"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#2a2a2a"/>

        <!-- Button style -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (jak admin) -->
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="💻 Client Panel"
                       FontSize="18"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <Border Background="#333"
                    CornerRadius="8"
                    Padding="8,4"
                    DockPanel.Dock="Right">
                <TextBlock Text="ONLINE"/>
            </Border>
        </DockPanel>

        <!-- CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- STATUS -->
            <Border Background="{StaticResource BackgroundCard}"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,10,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Status komputera"
                               FontSize="16"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="🟢 Aktywny"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Połączono z serwerem"
                               Foreground="#aaaaaa"
                               Margin="0,10,0,0"/>

                </StackPanel>
            </Border>

            <!-- TIMER PANEL -->
            <Border Grid.Column="1"
                    Background="{StaticResource BackgroundCard}"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="⏱ Timer"
                               FontSize="16"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="TimerText"
                               FontSize="22"
                               FontWeight="Bold"
                               Text="Brak"
                               Margin="0,0,0,10"/>

                </StackPanel>
            </Border>
        </Grid>

        <!-- BLOKADA (overlay jak admin styl) -->
        <Grid x:Name="BlockOverlay"
              Background="#DD111111"
              Visibility="Collapsed"
              Panel.ZIndex="10">

            <Border Background="{StaticResource BackgroundCard}"
                    CornerRadius="12"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="🔒"
                               FontSize="50"
                               TextAlignment="Center"/>

                    <TextBlock Text="KOMPUTER ZABLOKOWANY"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,10"
                               TextAlignment="Center"/>

                    <TextBlock Text="Został zablokowany przez administratora"
                               Foreground="#cccccc"
                               TextAlignment="Center"/>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
