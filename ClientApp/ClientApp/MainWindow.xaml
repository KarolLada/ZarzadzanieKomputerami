<Window x:Class="ClientApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client PC" Height="400" Width="600">

    <Grid>

        <!-- FAKE DESKTOP -->
        <TextBlock Text="To jest komputer klienta"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="20"/>
<!-- /\ -->

        <!-- BLOKADA -->
        <Grid x:Name="BlockOverlay"
              Background="#AA000000"
              Visibility="Collapsed">

            <TextBlock Text="KOMPUTER ZABLOKOWANY"
                       Foreground="White"
                       FontSize="30"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </Grid> // Implementacja ekranu blokady
</Window>
